# Shopee Affiliate Open API — copie do menu Abrir API (nunca envie estes dados a ninguém).
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Telegram — token criado no @BotFather e o ID numérico do grupo Diegola Promoções.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: ID do tópico "Promoções imperdíveis". Deixe vazio se não usar tópicos.
TELEGRAM_MESSAGE_THREAD_ID=

# Seleção das ofertas.
KEYWORDS=oferta,promoção,eletrônico,celular,casa,cozinha,informática
MIN_DISCOUNT_PERCENT=10
MIN_COMMISSION_PERCENT=1
POSTS_PER_CYCLE=4
POLL_MINUTES=45
